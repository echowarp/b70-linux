#!/bin/bash
# b70-power: set the Arc B70's power limit as the desktop user, no sudo (b70-powerd applies it as root).
#   b70-power          show: mode, target / applied limit, live card power, fan, VRAM temperature
#   b70-power 190      fixed 190 W until `b70-power auto` (150..330 W; the governor keeps it across profile changes)
#   b70-power auto     back to the power profile (see ../b70-governor: watts per profile in its config)
set -eu
CFG=${XDG_CONFIG_HOME:-$HOME/.config}/b70-governor
SOCK=${B70_POWERD_SOCK:-/run/b70-powerd.sock}
powerd() { python3 -I -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.settimeout(3); s.connect(sys.argv[1]); s.sendall((sys.argv[2]+"\n").encode()); print(s.recv(512).decode().strip())' "$SOCK" "$1"; }
show() {
  local st mode G H e1 e2
  st=$(powerd get 2>/dev/null) || st="powerd unreachable"
  if [ -s $CFG/override ]; then mode="manual $(cat $CFG/override) W"; else mode="auto ($(powerprofilesctl get 2>/dev/null || echo ?))"; fi
  echo "mode: $mode"
  echo "powerd: ${st#state }"
  G=$(lspci -D -d 8086:e223 | cut -d' ' -f1)
  H=$(ls -d /sys/bus/pci/devices/$G/hwmon/hwmon* 2>/dev/null | head -1)
  [ -n "$H" ] || { echo "card: not on the bus"; return; }
  e1=$(cat $H/energy1_input); sleep 1; e2=$(cat $H/energy1_input)
  echo "card: $(( (e2 - e1) / 1000000 )) W now, fan $(cat $H/fan1_input) rpm, VRAM $(( $(cat $H/temp3_input) / 1000 )) C"
}
wait_applied() {   # the governor polls every second; report what powerd applied
  local want=$1 st
  for _ in 1 2 3 4 5 6; do
    sleep 1; st=$(powerd get 2>/dev/null || true)
    case "$st" in *"target=$want "*) echo "applied: ${st#state }"; return 0;; esac
  done
  echo "the governor has not applied $want W yet (is b70-governor running? systemctl --user status b70-governor)"; return 1
}
case "${1:-}" in
  "") show ;;
  auto) rm -f $CFG/override; echo "auto: following the power profile"; sleep 2; show ;;
  *[!0-9]*|-h|--help) sed -n 2,5p "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
  *) w=$1
     [ "$w" -ge 150 ] && [ "$w" -le 330 ] || { echo "watts must be 150..330"; exit 2; }
     mkdir -p $CFG; echo "$w" > $CFG/override.tmp; mv $CFG/override.tmp $CFG/override
     wait_applied "$w" ;;
esac
