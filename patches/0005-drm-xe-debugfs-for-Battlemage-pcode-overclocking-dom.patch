+++ b/drivers/gpu/drm/xe/xe_pcode.c
@@ -132,6 +132,50 @@ int xe_pcode_write64_timeout(struct xe_tile *tile, u32 mbox, u32 data0, u32 data
 	return err;
 }
 
+/**
+ * xe_pcode_rw_status - mailbox transaction that returns pcode's raw status
+ * @tile: tile
+ * @mbox: PCODE_MBOX() command
+ * @data0: in/out DATA0
+ * @data1: in/out DATA1
+ *
+ * For callers that need to act on the status byte themselves (e.g. retry on
+ * busy) without the error log of the regular helpers.
+ *
+ * Returns: the status byte (0 = success) or a negative errno if the mailbox
+ * was busy or timed out.
+ */
+int xe_pcode_rw_status(struct xe_tile *tile, u32 mbox, u32 *data0, u32 *data1)
+{
+	struct xe_mmio *mmio = &tile->mmio;
+	int err;
+
+	if (tile_to_xe(tile)->info.skip_pcode)
+		return -ENODEV;
+
+	mutex_lock(&tile->pcode.lock);
+	if (xe_mmio_read32(mmio, PCODE_MAILBOX) & PCODE_READY) {
+		err = -EAGAIN;
+		goto unlock;
+	}
+
+	xe_mmio_write32(mmio, PCODE_DATA0, *data0);
+	xe_mmio_write32(mmio, PCODE_DATA1, *data1);
+	xe_mmio_write32(mmio, PCODE_MAILBOX, PCODE_READY | mbox);
+
+	err = xe_mmio_wait32(mmio, PCODE_MAILBOX, PCODE_READY, 0,
+			     10 * USEC_PER_MSEC, NULL, false);
+	if (err)
+		goto unlock;
+
+	*data0 = xe_mmio_read32(mmio, PCODE_DATA0);
+	*data1 = xe_mmio_read32(mmio, PCODE_DATA1);
+	err = xe_mmio_read32(mmio, PCODE_MAILBOX) & PCODE_ERROR_MASK;
+unlock:
+	mutex_unlock(&tile->pcode.lock);
+	return err;
+}
+
 int xe_pcode_read(struct xe_tile *tile, u32 mbox, u32 *val, u32 *val1)
 {
 	int err;
